{
  "name": "grooveprint",
  "private": true,
  "version": "3.0.0-alpha.1",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/app.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:syntax": "node --check server/app.mjs && node --check server/bpm-match.mjs && node --check server/bpm-open.mjs && node --check src/bpm-tempo.mjs && node --check src/bpm-library.js && node --check src/auto-bpm.js && node --check scripts/bpm-benchmark.mjs && node --check src/bpm-tempo-experiment.mjs && node --check scripts/bpm-browser-benchmark.mjs && node --check scripts/waivops-pilot.mjs",
    "benchmark:quick": "node scripts/bpm-benchmark.mjs --synthetic --quick",
    "benchmark:synthetic": "node scripts/bpm-benchmark.mjs --synthetic",
    "benchmark:real": "node scripts/bpm-benchmark.mjs --real --manifest .private/tempo-dataset/manifest.json --decoder ffmpeg",
    "benchmark:compare": "node scripts/bpm-benchmark.mjs --synthetic --compare src/bpm-tempo-experiment.mjs --out .private/benchmarks/compare",
    "benchmark:browser": "node scripts/bpm-browser-benchmark.mjs --manifest .private/tempo-dataset/manifest.json",
    "benchmark:licensed-techno": "node scripts/waivops-pilot.mjs --limit 12",
    "benchmark:licensed-techno:dry": "node scripts/waivops-pilot.mjs --dry-run --limit 12"
  }
}
